# Next.js runtime (public + server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
APP_URL=

# Only needed if server-side admin tasks are ever added. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 — these are consumed by the `presign-r2` Supabase Edge Function,
# NOT by the Next.js app. Set them with `supabase secrets set`, e.g.
#   supabase secrets set R2_ACCESS_KEY_ID=... R2_SECRET_ACCESS_KEY=... \
#     CLOUDFLARE_ACCOUNT_ID=... R2_BUCKET=foundry-menu \
#     R2_PUBLIC_BASE_URL=https://media.foundryartisancoffee.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET=foundry-menu
R2_PUBLIC_BASE_URL=https://media.foundryartisancoffee.com
